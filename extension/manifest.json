{
  "manifest_version": 3,
  "name": "WMATA Overlay for Map Widgets",
  "short_name": "WMATA Overlay",
  "version": "1.2.0",
  "description": "Draws DC's WMATA Metro lines and Metrobus routes and stops on Google Maps and OpenStreetMap (Leaflet) maps on any website.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/settings.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "WMATA Overlay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-overlays": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Turn all map overlays on/off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/page/canvas-layer.js",
        "src/page/metro.js",
        "src/page/bus.js",
        "src/page/core.js",
        "src/page/google-maps-site.js",
        "src/page/leaflet.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wmata-overlay@jsifuentes.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
